---
interface Props {
  title: string;
  image: string;
  description: string;
  url: string;
}

const { title, image, description, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col bg-white shadow-md rounded-lg overflow-hidden transition hover:shadow-xl hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-lavender-blue-500"
>
  <img
    src={image}
    alt={`${title} logo`}
    width="640"
    height="192"
    loading="lazy"
    decoding="async"
    class="w-full h-48 object-contain bg-white p-4"
  />
  <div class="p-4 grow flex flex-col">
    <h3 class="text-xl font-bold mb-2 text-black">{title}</h3>
    {description && <p class="text-gray-600 mb-4">{description}</p>}
    <span
      class="mt-auto text-blue-600 group-hover:text-blue-800 group-hover:underline"
    >
      View openings &rarr;
    </span>
  </div>
</a>
