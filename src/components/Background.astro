<div
  class="fixed inset-0 -z-10 overflow-hidden bg-[#0c1220]"
  role="presentation"
  aria-hidden="true"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_100%,rgba(39,86,115,0.48),transparent_58%),radial-gradient(ellipse_at_15%_85%,rgba(74,47,112,0.32),transparent_55%),#0c1220]"
  ></div>
  <canvas
    id="aurora-bg"
    class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700"
  ></canvas>
</div>

<script>
  const canvas = document.getElementById("aurora-bg") as HTMLCanvasElement;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const init = async () => {
    try {
      const { createShaderRenderer } = await import("shadertown");
      const renderer = createShaderRenderer(canvas, {
        shader: "aurora",
        params: { speed: 0.35, intensity: 0.8, warp: 0.45 },
        dpr: [1, 1.25],
        paused: reducedMotion,
        onStatus(status) {
          if (status === "ready") canvas.classList.replace("opacity-0", "opacity-100");
          if (status === "unsupported" || status === "error") canvas.remove();
        },
      });

      renderer.ready.catch(() => canvas.remove());
      window.addEventListener("pagehide", () => renderer.destroy(), { once: true });
    } catch {
      // Keep the CSS night-sky fallback visible if WebGPU cannot initialize.
      canvas.remove();
    }
  };

  if ("requestIdleCallback" in window) {
    requestIdleCallback(init);
  } else {
    setTimeout(init, 1000);
  }
</script>
