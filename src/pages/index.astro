---
import { Image } from "astro:assets";
import Background from "../components/Background.astro";
import BaseHead from "../components/BaseHead.astro";
import icpLogo from "../assets/icp-logo.png";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_SOCIAL_IMAGE } from "../consts";

const jobsFile = JSON.parse(
  await (await import("node:fs/promises")).readFile("src/data/jobs.json", "utf8"),
);
const jobCount = jobsFile.jobs.length;
const jobBoardCount = jobsFile.boards.filter((b: { skipped: string | null }) => !b.skipped).length;

const { getCollection } = await import("astro:content");
const boardCount = (await getCollection("boards")).length;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image={SITE_SOCIAL_IMAGE}
    />
  </head>

  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-10 bg-black/90 backdrop-blur text-white py-4">
      <nav class="container mx-auto px-4 flex flex-wrap justify-between items-center gap-4">
        <a href="/" class="text-lg sm:text-xl font-bold leading-tight">The Great Crypto VC Job Board</a>
        <Image
          src={icpLogo}
          alt="Internet Computer logo"
          width={320}
          format="webp"
          quality={80}
          loading="eager"
          class="w-24 sm:w-32 md:w-40 h-auto"
        />
      </nav>
    </header>

    <main class="grow flex items-center">
      <div class="container mx-auto px-4 py-16">
        <div class="max-w-2xl mx-auto text-center mb-12">
          <h1 class="text-3xl sm:text-4xl font-bold mb-3">The Great Crypto VC Job Board</h1>
          <p class="text-gray-600">{SITE_DESCRIPTION}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
          <a
            href="/jobs"
            class="group flex flex-col gap-2 bg-white shadow-md rounded-lg p-8 border border-gray-100 transition hover:shadow-xl hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-lavender-blue-500"
          >
            <h2 class="text-2xl font-bold text-black group-hover:text-lavender-blue-600">Jobs</h2>
            <p class="text-sm text-gray-600">
              Browse {jobCount} live roles pulled directly from {jobBoardCount} portfolio job boards.
            </p>
            <span class="mt-auto text-lavender-blue-600 group-hover:text-lavender-blue-800 group-hover:underline">
              View live postings &rarr;
            </span>
          </a>

          <a
            href="/job-boards"
            class="group flex flex-col gap-2 bg-white shadow-md rounded-lg p-8 border border-gray-100 transition hover:shadow-xl hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-lavender-blue-500"
          >
            <h2 class="text-2xl font-bold text-black group-hover:text-lavender-blue-600">Job Boards</h2>
            <p class="text-sm text-gray-600">
              Browse all {boardCount} portfolio job boards directly, including the ones without a live feed.
            </p>
            <span class="mt-auto text-lavender-blue-600 group-hover:text-lavender-blue-800 group-hover:underline">
              View job boards &rarr;
            </span>
          </a>
        </div>
      </div>
    </main>

    <footer class="bg-gray-800 text-white py-4">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm">
          An initiative by <a href="https://x.com/IshaaqZiyan" class="text-blue-500 underline">IshaaqZiyan</a> <br>
          This project is open-source, and all logos and related assets used in this project belong to their respective owners.
        </p>
      </div>
    </footer>

    <Background/>
  </body>
</html>
