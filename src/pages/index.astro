---
import blogPosts from '../components/blogPosts.json';
import Article from '../components/Article.astro';
import Background from "../components/Background.astro";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_SOCIAL_IMAGE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image={SITE_SOCIAL_IMAGE}
    />
  </head>

  <body class="min-h-screen flex flex-col">
    <header class="bg-black/70 text-white py-4">
      <nav class="container mx-auto px-4 flex flex-wrap justify-between items-center gap-4">
        <a href="/" class="text-lg sm:text-xl font-bold leading-tight">The Great Crypto VC Job Board</a>
        <img
          src="/100.png"
          alt="Internet Computer logo"
          width="160"
          height="40"
          class="w-24 sm:w-32 md:w-40 h-auto"
        />
      </nav>
    </header>

    <main class="grow">
      <div class="container mx-auto my-8 px-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {blogPosts.map((post) => (
            <Article
              title={post.title}
              image={post.image.replace(/^\.\//, "/")}
              description={post.description}
              url={post.url}
            />
          ))}
        </div>
      </div>
    </main>

    <footer class="bg-gray-800 text-white py-4">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm">
          An initiative by <a href="https://x.com/IshaaqZiyan" class="text-blue-500 underline">IshaaqZiyan</a> <br>
          This project is open-source, and all logos and related assets used in this project belong to their respective owners.
        </p>
      </div>
    </footer>

    <Background/>
  </body>
</html>
